# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais

# PostgreSQL (Docker local)
POSTGRES_USER=korp
POSTGRES_PASSWORD=<sua-senha-dev>
POSTGRES_DB=korp

# Estoque.API — connection string local
ESTOQUE_CONNECTION_STRING=Host=localhost;Port=5432;Database=korp;Username=korp;Password=<sua-senha-dev>;Search Path=korp_estoque

# Faturamento.API — connection string local
FATURAMENTO_CONNECTION_STRING=Host=localhost;Port=5432;Database=korp;Username=korp;Password=<sua-senha-dev>;Search Path=korp_faturamento
ESTOQUE_SERVICE_URL=http://localhost:5001

# Gemini AI (chave fica somente no backend — nunca no frontend)
# Obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<sua-chave-gemini>

# Produção (Supabase/Render — configure no dashboard, não aqui)
# ConnectionStrings__DefaultConnection=Host=<host>.supabase.co;...
# Gemini__ApiKey=<chave-producao>
